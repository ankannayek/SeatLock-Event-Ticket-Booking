# Copy this file to .env and adjust. Real environment variables override it.

# --- Security (generate with: python -c "import secrets; print(secrets.token_hex(32))") ---
SEATLOCK_SECRET_KEY=change-me
SEATLOCK_JWT_SECRET=change-me-too
SEATLOCK_JWT_EXPIRY_HOURS=24

# --- Database ---
# Leave unset for SQLite (instance/seatlock.db). For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/seatlock

# --- Seat holds ---
SEATLOCK_HOLD_MINUTES=10
SEATLOCK_MAX_SEATS_PER_HOLD=8
SEATLOCK_CLEANUP_SECONDS=30

# --- Server ---
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false

# --- Frontend ---
# Where the built React app lives (defaults to frontend/dist).
# FRONTEND_DIST=frontend/dist
# Only needed when the frontend is hosted on a different origin.
# CORS_ORIGINS=http://localhost:5173
