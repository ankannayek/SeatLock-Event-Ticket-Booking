# Copy to .env. Only variables starting with VITE_ reach the browser.

# Base URL of the API. Keep "/api" when Flask serves the app or when using
# the Vite dev proxy. Use a full URL (and set CORS_ORIGINS on the backend)
# if the API is hosted elsewhere, e.g. https://api.example.com/api
VITE_API_URL=/api

# Where the Vite dev server forwards /api requests (dev only).
VITE_PROXY_TARGET=http://127.0.0.1:5000

# Shown in the header and page titles.
VITE_APP_NAME=SeatLock

# Show "fill demo account" shortcuts on the sign-in page. Turn off in production.
VITE_SHOW_DEMO_LOGIN=true
